{
    "$id": "admin.beta.guide.json",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "id",
        "partKey",
        "isDefault",
        "recording",
        "submissionId",
        "singer",
        "publishedAt",
        "pitchPercent",
        "source",
        "aiVoice",
        "review"
    ],
    "properties": {
        "id": {
            "type": "string"
        },
        "partKey": {
            "type": "string"
        },
        "isDefault": {
            "type": "boolean"
        },
        "recording": {
            "$ref": "guide.recording.json"
        },
        "submissionId": {
            "type": [
                "string",
                "null"
            ]
        },
        "singer": {
            "$ref": "admin.person.json"
        },
        "publishedAt": {
            "type": "string",
            "format": "date-time"
        },
        "pitchPercent": {
            "type": [
                "integer",
                "null"
            ],
            "description": "That version's take score, to compare a part's versions."
        },
        "reports": {
            "type": "integer",
            "description": "Open reports on this voice."
        },
        "source": {
            "type": "string",
            "enum": [
                "recorded",
                "ai"
            ]
        },
        "aiVoice": {
            "type": [
                "object",
                "null"
            ],
            "additionalProperties": false,
            "required": [
                "id",
                "name"
            ],
            "properties": {
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string",
                    "description": "The AI voice's label name (admin.aiVoice)."
                }
            },
            "description": "The AI voice that sang it; null for a recorded guide."
        },
        "review": {
            "type": [
                "string",
                "null"
            ],
            "description": "An AI guide's review: pending, approved or rejected; null for a recorded one. Only approved AI guides reach the app and the site."
        }
    }
}
