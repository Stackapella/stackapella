{
    "$id": "admin.beta.template.json",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "id",
        "version",
        "title",
        "reviewed",
        "parts",
        "olderGuides",
        "staged"
    ],
    "properties": {
        "id": {
            "type": "string"
        },
        "version": {
            "type": "integer"
        },
        "title": {
            "type": "string"
        },
        "reviewed": {
            "type": "boolean"
        },
        "parts": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "key",
                    "name",
                    "guides",
                    "needs"
                ],
                "properties": {
                    "key": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "guides": {
                        "type": "array",
                        "items": {
                            "$ref": "admin.beta.guide.json"
                        }
                    },
                    "needs": {
                        "$ref": "admin.beta.part-needs.json"
                    }
                }
            }
        },
        "olderGuides": {
            "type": "integer",
            "description": "Guides recorded for older versions of this template (kept, flagged; the synth plays until a new take is accepted)."
        },
        "staged": {
            "type": [
                "object",
                "null"
            ],
            "additionalProperties": false,
            "required": [
                "version",
                "changed"
            ],
            "properties": {
                "version": {
                    "type": "integer",
                    "description": "The staged next version, which new recordings target."
                },
                "changed": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "The parts whose notes change in it, which need new voices; the others move over at the switch."
                }
            },
            "description": "A staged next version (the content's <id>.next.json, never current), or null."
        }
    },
    "title": "One template's real voices: \"3 of 4 parts are real voices\""
}
