{
    "$id": "admin.block.json",
    "title": "One entry on the blocklist",
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "type", "value", "reason", "expiresAt", "createdAt", "createdBy"],
    "properties": {
        "id": { "type": "string", "description": "A Sqid." },
        "type": { "type": "string", "enum": ["email", "email_domain", "ip", "ip_range", "card_fingerprint"] },
        "value": { "type": "string", "description": "Lower-cased for emails and domains; an IP, a CIDR range, or a Stripe card fingerprint." },
        "reason": { "type": "string" },
        "expiresAt": { "type": ["string", "null"], "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "$ref": "admin.person.json" }
    }
}
