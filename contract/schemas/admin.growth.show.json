{
    "type": "object",
    "additionalProperties": false,
    "required": [
        "data"
    ],
    "properties": {
        "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "date",
                "from",
                "to",
                "tiles",
                "steps"
            ],
            "properties": {
                "date": {
                    "type": "string",
                    "description": "Today (UTC), YYYY-MM-DD."
                },
                "from": {
                    "type": "string"
                },
                "to": {
                    "type": "string"
                },
                "tiles": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "key",
                            "today",
                            "yesterday",
                            "lastWeek",
                            "current",
                            "previous",
                            "weekAgo",
                            "lowSample"
                        ],
                        "properties": {
                            "key": {
                                "type": "string",
                                "enum": [
                                    "arrivals",
                                    "lesson1",
                                    "signedUp",
                                    "plusStarted"
                                ]
                            },
                            "today": {
                                "type": "integer"
                            },
                            "yesterday": {
                                "type": "integer"
                            },
                            "lastWeek": {
                                "type": "integer",
                                "description": "The same weekday last week."
                            },
                            "current": {
                                "type": "integer",
                                "description": "Over the period (`days`, ending today)."
                            },
                            "previous": {
                                "type": "integer",
                                "description": "The same number of days just before it."
                            },
                            "weekAgo": {
                                "type": "integer",
                                "description": "The same days a week back (Today: the same weekday last week; 7 days: the week before)."
                            },
                            "lowSample": {
                                "type": "boolean",
                                "description": "`current` is under 20: its change is noise, so the Overview says \"few so far\"."
                            }
                        }
                    }
                },
                "steps": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "key",
                            "total"
                        ],
                        "properties": {
                            "key": {
                                "type": "string",
                                "enum": [
                                    "visits",
                                    "start",
                                    "arrivals",
                                    "lesson1",
                                    "unit1",
                                    "signedUp",
                                    "plusStarted"
                                ]
                            },
                            "total": {
                                "type": "integer"
                            }
                        }
                    }
                },
                "timezone": {
                    "type": "string",
                    "description": "The timezone the days are in (a PHP name; UTC unless set)."
                }
            }
        }
    }
}
