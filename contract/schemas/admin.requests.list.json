{
    "$id": "admin.requests.list.json",
    "title": "admin.requests.list",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "data",
        "meta"
    ],
    "properties": {
        "data": {
            "type": "array",
            "items": {
                "title": "A song request as admin sees it",
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "id",
                    "title",
                    "writer",
                    "why",
                    "votes",
                    "voted",
                    "mine",
                    "status",
                    "template",
                    "createdAt",
                    "held",
                    "hidden",
                    "mergedInto",
                    "reports"
                ],
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "title": {
                        "type": "string"
                    },
                    "writer": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "why": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "votes": {
                        "type": "integer"
                    },
                    "voted": {
                        "type": "boolean"
                    },
                    "mine": {
                        "type": "boolean",
                        "description": "The caller asked for it."
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "requested",
                            "checking",
                            "arranging",
                            "ready",
                            "cant"
                        ]
                    },
                    "template": {
                        "type": [
                            "object",
                            "null"
                        ],
                        "additionalProperties": false,
                        "required": [
                            "id",
                            "title"
                        ],
                        "properties": {
                            "id": {
                                "type": "string"
                            },
                            "title": {
                                "type": "string"
                            }
                        }
                    },
                    "createdAt": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "held": {
                        "type": "boolean"
                    },
                    "hidden": {
                        "type": "boolean"
                    },
                    "mergedInto": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "reports": {
                        "type": "integer"
                    }
                }
            }
        },
        "meta": {
            "$ref": "meta.json"
        }
    }
}
