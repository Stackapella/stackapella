{
    "$id": "admin.song-video.json",
    "title": "A synced recording in the sync tool",
    "description": "song-video.json's fields plus its state.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "id",
        "videoId",
        "title",
        "channel",
        "durationSeconds",
        "templateVersion",
        "form",
        "anchors",
        "harmony",
        "otherWords",
        "song",
        "status",
        "hiddenReason",
        "checkedAt",
        "syncedBy",
        "approvedBy",
        "approvedAt"
    ],
    "properties": {
        "id": {
            "type": "string"
        },
        "videoId": {
            "type": "string",
            "description": "YouTube's 11-character id."
        },
        "title": {
            "type": "string"
        },
        "channel": {
            "type": "string"
        },
        "durationSeconds": {
            "type": "integer"
        },
        "templateVersion": {
            "type": "integer",
            "description": "The song's version the map was made against."
        },
        "form": {
            "type": "array",
            "items": {
                "$ref": "song-video.json#/$defs/segment"
            }
        },
        "anchors": {
            "type": "array",
            "items": {
                "type": "array",
                "items": {
                    "type": "number"
                },
                "description": "[videoSeconds, performanceBeat] (anchors) or [fromBeat, toBeat] (otherWords)."
            }
        },
        "harmony": {
            "type": "string",
            "enum": [
                "same",
                "similar",
                "different"
            ]
        },
        "otherWords": {
            "type": "array",
            "items": {
                "type": "array",
                "items": {
                    "type": "number"
                },
                "description": "[videoSeconds, performanceBeat] (anchors) or [fromBeat, toBeat] (otherWords)."
            },
            "description": "Performance-beat ranges where the recording sings words the template doesn't carry."
        },
        "song": {
            "type": "string"
        },
        "status": {
            "type": "string",
            "enum": [
                "draft",
                "approved"
            ]
        },
        "hiddenReason": {
            "type": [
                "string",
                "null"
            ],
            "description": "Why YouTube's last check hid it, or null: removed, private, not_embeddable, made_for_kids or age_restricted."
        },
        "checkedAt": {
            "type": "string",
            "format": "date-time"
        },
        "syncedBy": {
            "type": [
                "object",
                "null"
            ],
            "additionalProperties": false,
            "required": [
                "name"
            ],
            "properties": {
                "name": {
                    "type": "string"
                }
            }
        },
        "approvedBy": {
            "type": [
                "object",
                "null"
            ],
            "additionalProperties": false,
            "required": [
                "name"
            ],
            "properties": {
                "name": {
                    "type": "string"
                }
            }
        },
        "approvedAt": {
            "type": [
                "string",
                "null"
            ],
            "format": "date-time"
        }
    }
}
