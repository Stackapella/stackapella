{
    "$id": "admin.songVideos.search.json",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "data"
    ],
    "properties": {
        "data": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "id",
                    "title",
                    "channel",
                    "durationSeconds",
                    "usable",
                    "hiddenReason"
                ],
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "title": {
                        "type": "string"
                    },
                    "channel": {
                        "type": "string"
                    },
                    "durationSeconds": {
                        "type": "integer"
                    },
                    "usable": {
                        "type": "boolean",
                        "description": "False when we may not show it (hiddenReason says why)."
                    },
                    "hiddenReason": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "Why we may not show it, or null: private, not_embeddable, made_for_kids or age_restricted."
                    }
                }
            }
        }
    }
}
