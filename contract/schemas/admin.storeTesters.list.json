{
    "$id": "admin.storeTesters.list.json",
    "title": "The accounts marked as store testers",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "data"
    ],
    "properties": {
        "data": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "id",
                    "name",
                    "email",
                    "since"
                ],
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "email": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "since": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            }
        }
    }
}
