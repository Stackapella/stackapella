{
    "type": "object",
    "additionalProperties": false,
    "required": [
        "data",
        "meta"
    ],
    "properties": {
        "data": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "id",
                    "category",
                    "status",
                    "from",
                    "preview",
                    "createdAt",
                    "answeredAt"
                ],
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "category": {
                        "type": "string",
                        "enum": [
                            "account",
                            "payments",
                            "recording",
                            "coaching",
                            "other",
                            "diagnostics",
                            "bug",
                            "idea",
                            "tracks"
                        ]
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "open",
                            "answered",
                            "closed"
                        ]
                    },
                    "from": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "email",
                            "account"
                        ],
                        "properties": {
                            "email": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "account": {
                                "type": [
                                    "object",
                                    "null"
                                ],
                                "additionalProperties": false,
                                "required": [
                                    "id",
                                    "name"
                                ],
                                "properties": {
                                    "id": {
                                        "type": "string"
                                    },
                                    "name": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    },
                    "preview": {
                        "type": "string"
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "answeredAt": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "tracks": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "groupId",
                            "group",
                            "piece",
                            "composer",
                            "voicing",
                            "rights",
                            "rightsConfirmedAt",
                            "rightsStatement",
                            "status",
                            "scores",
                            "song",
                            "deliveredAt",
                            "give"
                        ],
                        "properties": {
                            "groupId": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "group": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "piece": {
                                "type": "string"
                            },
                            "composer": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "voicing": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "rights": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "enum": [
                                    "public-domain",
                                    "own-arrangement",
                                    null
                                ]
                            },
                            "rightsConfirmedAt": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "format": "date-time"
                            },
                            "rightsStatement": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "description": "The exact sentence the director confirmed (null on requests from before it was kept)."
                            },
                            "status": {
                                "type": "string",
                                "enum": [
                                    "received",
                                    "delivered",
                                    "closed"
                                ]
                            },
                            "scores": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "required": [
                                        "id",
                                        "name",
                                        "kind",
                                        "bytes",
                                        "url"
                                    ],
                                    "properties": {
                                        "id": {
                                            "type": "string"
                                        },
                                        "name": {
                                            "type": "string"
                                        },
                                        "kind": {
                                            "type": "string",
                                            "enum": [
                                                "pdf",
                                                "musicxml",
                                                "mxl",
                                                "photo"
                                            ]
                                        },
                                        "bytes": {
                                            "type": "integer"
                                        },
                                        "url": {
                                            "type": [
                                                "string",
                                                "null"
                                            ],
                                            "format": "uri",
                                            "description": "A 10-minute download link, in admin.support.show only."
                                        }
                                    }
                                }
                            },
                            "song": {
                                "type": [
                                    "object",
                                    "null"
                                ],
                                "additionalProperties": false,
                                "required": [
                                    "id",
                                    "title"
                                ],
                                "properties": {
                                    "id": {
                                        "type": "string"
                                    },
                                    "title": {
                                        "type": "string"
                                    }
                                }
                            },
                            "deliveredAt": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "format": "date-time"
                            },
                            "give": {
                                "type": [
                                    "object",
                                    "null"
                                ],
                                "additionalProperties": false,
                                "required": [
                                    "rights"
                                ],
                                "description": "What admin.people.songs.create takes as the rights record, from the request (null when its rights weren't kept).",
                                "properties": {
                                    "rights": {
                                        "type": "object",
                                        "additionalProperties": false,
                                        "required": [
                                            "confirmedBy",
                                            "confirmedAt",
                                            "wording",
                                            "source"
                                        ],
                                        "properties": {
                                            "confirmedBy": {
                                                "type": "string"
                                            },
                                            "confirmedAt": {
                                                "type": "string",
                                                "format": "date-time"
                                            },
                                            "wording": {
                                                "type": "string"
                                            },
                                            "source": {
                                                "type": "string"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "meta": {
            "$ref": "meta.json"
        }
    },
    "$id": "admin.support.list.json"
}
