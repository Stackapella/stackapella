{
    "type": "object",
    "additionalProperties": false,
    "required": [
        "data",
        "meta"
    ],
    "properties": {
        "data": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "id",
                    "category",
                    "status",
                    "from",
                    "preview",
                    "createdAt",
                    "answeredAt"
                ],
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "category": {
                        "type": "string",
                        "enum": [
                            "account",
                            "payments",
                            "recording",
                            "coaching",
                            "other",
                            "diagnostics",
                            "bug",
                            "idea",
                            "tracks"
                        ]
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "open",
                            "answered",
                            "closed"
                        ]
                    },
                    "from": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "email",
                            "account"
                        ],
                        "properties": {
                            "email": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "account": {
                                "type": [
                                    "object",
                                    "null"
                                ],
                                "additionalProperties": false,
                                "required": [
                                    "id",
                                    "name"
                                ],
                                "properties": {
                                    "id": {
                                        "type": "string"
                                    },
                                    "name": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    },
                    "preview": {
                        "type": "string"
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "answeredAt": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "tracks": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "groupId",
                            "group",
                            "piece",
                            "composer",
                            "voicing",
                            "rights",
                            "rightsConfirmedAt"
                        ],
                        "properties": {
                            "groupId": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "group": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "piece": {
                                "type": "string"
                            },
                            "composer": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "voicing": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "rights": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "enum": [
                                    "public-domain",
                                    "own-arrangement",
                                    null
                                ]
                            },
                            "rightsConfirmedAt": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "format": "date-time"
                            }
                        }
                    }
                }
            }
        },
        "meta": {
            "$ref": "meta.json"
        }
    },
    "$id": "admin.support.list.json"
}
