{
    "$id": "auth.config.json",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "data"
    ],
    "properties": {
        "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "methods",
                "signups",
                "turnstileSiteKey",
                "passwordMinLength",
                "comingSoon",
                "prelaunch",
                "instrumentsIndexUrl",
                "selfHosted",
                "sentryDsn",
                "usageCounts",
                "coachSignup",
                "humTune",
                "ideas",
                "plusCourses",
                "sheetImport",
                "lendVoice",
                "experiment",
                "experiments",
                "schools",
                "songRequests",
                "languages",
                "withheldSongs"
            ],
            "properties": {
                "methods": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "google",
                            "apple",
                            "event_schedule",
                            "password"
                        ]
                    },
                    "description": "The sign-in methods on offer, in order (the last one used first is the app's to remember)."
                },
                "signups": {
                    "type": "string",
                    "enum": [
                        "open",
                        "password_paused",
                        "paused"
                    ],
                    "description": "An attack switch: new accounts with a password, or any new accounts, paused for now."
                },
                "sentryDsn": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "The browser error reporter's Sentry DSN (public by design): its envelopes go to /log/errors, which scrubs and forwards them. Null when it isn't set up, and the app sends nothing."
                },
                "turnstileSiteKey": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Set while shield mode is on: show Cloudflare Turnstile on sign-up, sign-in and reset, and send its token as turnstileToken."
                },
                "passwordMinLength": {
                    "type": "integer"
                },
                "comingSoon": {
                    "type": "boolean",
                    "description": "Before launch, and this visitor isn't let in yet (no beta pass, not signed in): show only signing in, the emails' token pages and the invite pages. Never cached (no-store)."
                },
                "prelaunch": {
                    "type": "boolean",
                    "description": "Before launch (coming soon is on), whoever is asking; comingSoon is false for anyone let in."
                },
                "instrumentsIndexUrl": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "format": "uri",
                    "description": "The real-instrument samples' index (instruments/index.json on the media CDN): each instrument's current version and its manifest. Null where instruments are off: the apps use the synth."
                },
                "selfHosted": {
                    "type": "boolean",
                    "description": "A self-hosted install (SELF_HOSTED on its server): every account has Plus, so the app shows no Plus page link, Get Plus button or See Plus, and says Plus is included. False on stackapella.com."
                },
                "usageCounts": {
                    "type": "boolean",
                    "description": "Whether the app sends its anonymous usage counts (counts.create). False on a self-hosted install unless its owner turns them on."
                },
                "coachSignup": {
                    "type": "boolean",
                    "description": "Coaches can apply (the coach_signup switch); the directory that lists them is a separate switch."
                },
                "humTune": {
                    "type": "boolean",
                    "description": "Hum a tune is on in the app (the your_tune switch, which also turns the site's /features/your-tune page to \"now\")."
                },
                "ideas": {
                    "type": "boolean",
                    "description": "Ideas is on (the ideas switch): the shelf of tunes waiting for voices, and sharing a song as an idea. While false the app shows no Ideas."
                },
                "plusCourses": {
                    "type": "boolean",
                    "description": "The Plus courses are live (the plus_courses switch): anyone, signed out too, can try a live course's free first lesson. account.plusCourses is the same switch, plus staff before it opens."
                },
                "songRequests": {
                    "type": "boolean",
                    "description": "The song_requests switch: song requests are open to everyone."
                },
                "sheetImport": {
                    "type": "boolean",
                    "description": "Sheet music import is on in the app (the sheet_import switch); staff see it before."
                },
                "lendVoice": {
                    "type": "boolean",
                    "description": "Lend your voice is on (the lend_voice switch): volunteers claim the songs' and lessons' missing real voices."
                },
                "experiment": {
                    "type": [
                        "object",
                        "null"
                    ],
                    "additionalProperties": false,
                    "required": [
                        "id",
                        "arms",
                        "enrol"
                    ],
                    "properties": {
                        "id": {
                            "type": "string"
                        },
                        "arms": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "enrol": {
                            "type": "boolean",
                            "description": "A new device draws an arm at its first open (f_arrive) only while true (from the experiment's start until its end day); devices already in an arm keep sending it."
                        }
                    },
                    "description": "The funnel's running A/B experiment (admin.funnel.show), or null when none runs or usage counts are off. A device sends \"<id>-<arm>\" as counts.create's variant."
                },
                "experiments": {
                    "type": "array",
                    "description": "Every running experiment (docs/experiments-plan.md), for the app's experiment(id): drawn when the screen that differs first shows, kept on the device as an arm label, never an id. `experiment` stays onb1's until it ends.",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "id",
                            "arms",
                            "enrol",
                            "audience",
                            "excludes"
                        ],
                        "properties": {
                            "id": {
                                "type": "string"
                            },
                            "arms": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "required": [
                                        "arm",
                                        "weight"
                                    ],
                                    "properties": {
                                        "arm": {
                                            "type": "string",
                                            "enum": [
                                                "a",
                                                "b",
                                                "c"
                                            ]
                                        },
                                        "weight": {
                                            "type": "integer",
                                            "description": "Its share of new devices, out of 100."
                                        }
                                    }
                                }
                            },
                            "enrol": {
                                "type": "boolean",
                                "description": "New devices may still join."
                            },
                            "audience": {
                                "type": "object",
                                "additionalProperties": false,
                                "properties": {
                                    "new": {
                                        "type": "boolean",
                                        "description": "Only a device with no course started and no account."
                                    },
                                    "skin": {
                                        "type": "string",
                                        "enum": [
                                            "game",
                                            "serious"
                                        ]
                                    },
                                    "size": {
                                        "type": "string",
                                        "enum": [
                                            "phone",
                                            "desktop"
                                        ]
                                    },
                                    "signedIn": {
                                        "type": "boolean"
                                    },
                                    "firstWeek": {
                                        "type": "boolean",
                                        "description": "May enrol a singer in their first week (needs Hillel's OK)."
                                    }
                                }
                            },
                            "excludes": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "schools": {
                    "type": "boolean",
                    "description": "The school offer's class codes are open (docs/school-offer-plan.md)."
                },
                "languages": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "en",
                            "es",
                            "de"
                        ]
                    },
                    "description": "English, then each language switched on (lang_es, lang_de)."
                },
                "withheldSongs": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "The songs (slugs) withheld where the visitor is, by its copyright term (docs/geo-rights-plan.md): the app leaves them out and a course step sings its altSong. Never the country. Empty while geo_rights is off."
                }
            }
        }
    },
    "title": "What the sign-in screens need to know"
}
