{
    "$id": "billing.prices.json",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "data"
    ],
    "properties": {
        "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "prices",
                "trial",
                "startNowConsent",
                "seats",
                "startNowWords"
            ],
            "properties": {
                "prices": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "interval",
                            "currency",
                            "amountCents",
                            "taxInclusive"
                        ],
                        "properties": {
                            "interval": {
                                "type": "string",
                                "enum": [
                                    "month",
                                    "year"
                                ]
                            },
                            "currency": {
                                "type": "string",
                                "enum": [
                                    "usd",
                                    "eur",
                                    "gbp"
                                ]
                            },
                            "amountCents": {
                                "type": "integer"
                            },
                            "taxInclusive": {
                                "type": "boolean",
                                "description": "The amount includes tax (EUR, GBP), or tax is added at Checkout (USD)."
                            }
                        }
                    }
                },
                "trial": {
                    "type": [
                        "object",
                        "null"
                    ],
                    "additionalProperties": false,
                    "required": [
                        "days",
                        "intervals"
                    ],
                    "properties": {
                        "days": {
                            "type": "integer"
                        },
                        "intervals": {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "enum": [
                                    "month",
                                    "year"
                                ]
                            },
                            "description": "Which intervals offer it."
                        }
                    },
                    "description": "The trial on offer, or null."
                },
                "startNowConsent": {
                    "type": "boolean",
                    "description": "True for a visitor in the EU, EEA or UK (Cloudflare's country): the app asks for consent to start Plus at once, and billing.checkout needs startNowConsent: true. False when the country isn't known."
                },
                "seats": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "min",
                        "trialDays",
                        "prices"
                    ],
                    "properties": {
                        "min": {
                            "type": "integer",
                            "description": "The fewest seats a pack has."
                        },
                        "trialDays": {
                            "type": "integer",
                            "description": "The whole choir's free days on a group's first pack."
                        },
                        "prices": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                    "currency",
                                    "amountCents",
                                    "taxInclusive"
                                ],
                                "properties": {
                                    "currency": {
                                        "type": "string",
                                        "enum": [
                                            "usd",
                                            "eur",
                                            "gbp"
                                        ]
                                    },
                                    "amountCents": {
                                        "type": "integer",
                                        "description": "A seat, a year."
                                    },
                                    "taxInclusive": {
                                        "type": "boolean",
                                        "description": "The amount includes tax (EUR, GBP), or tax is added at Checkout (USD)."
                                    }
                                }
                            }
                        }
                    },
                    "description": "A choir's seats (docs/choir-seats-plan.md): yearly, per singer, from `min` seats."
                },
                "startNowWords": {
                    "type": [
                        "object",
                        "null"
                    ],
                    "additionalProperties": false,
                    "required": [
                        "version",
                        "text"
                    ],
                    "properties": {
                        "version": {
                            "type": "integer"
                        },
                        "text": {
                            "type": "string"
                        }
                    },
                    "description": "The consent's words to show by the tick box, in the request's language, at the version Checkout records; null when no consent is asked."
                }
            }
        }
    }
}
