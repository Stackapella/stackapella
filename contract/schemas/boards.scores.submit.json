{
    "type": "object",
    "additionalProperties": false,
    "required": [
        "data"
    ],
    "properties": {
        "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "counted",
                "why",
                "best",
                "improved",
                "before",
                "daily"
            ],
            "properties": {
                "counted": {
                    "type": "boolean",
                    "description": "Whether it qualified for the boards."
                },
                "why": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "enum": [
                        "mode",
                        "key",
                        "speed",
                        "guide",
                        "timing",
                        "bluetooth",
                        "take",
                        null
                    ],
                    "description": "Why it didn't count: sung along (mode), another key, another speed, the guide on, no passed timing check, Bluetooth output, or a take that isn't theirs for this part."
                },
                "best": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "description": "Their best on this part now (null: none yet)."
                },
                "improved": {
                    "type": "boolean"
                },
                "before": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "description": "Their best on this part's board before this take, set on any device (for \"up from\"): null on a first score or one that didn't count."
                },
                "daily": {
                    "type": [
                        "object",
                        "null"
                    ],
                    "additionalProperties": false,
                    "required": [
                        "counted",
                        "best",
                        "rank"
                    ],
                    "properties": {
                        "counted": {
                            "type": "boolean",
                            "description": "It went on that day's board (today's pick, a score that counts)."
                        },
                        "best": {
                            "type": [
                                "integer",
                                "null"
                            ],
                            "description": "Their best that day."
                        },
                        "rank": {
                            "type": [
                                "integer",
                                "null"
                            ],
                            "description": "Their place that day on the global board (null when they're not on it)."
                        }
                    },
                    "description": "With `daily` sent: that day's board; else null."
                }
            }
        }
    }
}
