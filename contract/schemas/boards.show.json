{
    "type": "object",
    "additionalProperties": false,
    "required": [
        "data"
    ],
    "properties": {
        "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "templateId",
                "templateVersion",
                "partKey",
                "scope",
                "scoringVersion",
                "entries",
                "you",
                "onGlobal",
                "current",
                "olderVersions"
            ],
            "properties": {
                "templateId": {
                    "type": "string"
                },
                "templateVersion": {
                    "type": "integer"
                },
                "partKey": {
                    "type": "string"
                },
                "scope": {
                    "type": "string",
                    "enum": [
                        "global",
                        "friends"
                    ]
                },
                "scoringVersion": {
                    "type": "integer"
                },
                "entries": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "id",
                            "rank",
                            "name",
                            "score",
                            "at",
                            "you"
                        ],
                        "properties": {
                            "id": {
                                "type": "string",
                                "description": "The entry's id, to report its name (reports.create boardEntryId)."
                            },
                            "rank": {
                                "type": "integer"
                            },
                            "name": {
                                "type": "string",
                                "description": "The public name rules; on a friends' board, someone under 18 by first name only. Never an email."
                            },
                            "score": {
                                "type": "integer"
                            },
                            "at": {
                                "type": "string",
                                "format": "date-time",
                                "description": "When that best was sung."
                            },
                            "you": {
                                "type": "boolean"
                            }
                        }
                    },
                    "description": "The top 10, best first (a tie goes to whoever sang it first)."
                },
                "you": {
                    "type": [
                        "object",
                        "null"
                    ],
                    "additionalProperties": false,
                    "required": [
                        "score",
                        "rank"
                    ],
                    "properties": {
                        "score": {
                            "type": "integer"
                        },
                        "rank": {
                            "type": [
                                "integer",
                                "null"
                            ],
                            "description": "Null when they're not on this board (the global board without the opt-in)."
                        }
                    },
                    "description": "Their own best on this part, or null."
                },
                "onGlobal": {
                    "type": "boolean"
                },
                "current": {
                    "type": "boolean",
                    "description": "This is the song's current arrangement; an earlier one's board is read only."
                },
                "olderVersions": {
                    "type": "array",
                    "items": {
                        "type": "integer"
                    },
                    "description": "Earlier versions of the song with entries on this part, newest first (`?version=`)."
                }
            }
        }
    }
}
