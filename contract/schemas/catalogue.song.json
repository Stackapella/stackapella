{
    "$id": "catalogue.song.json",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "id",
        "version",
        "title",
        "description",
        "difficulty",
        "genre",
        "language",
        "key",
        "tempo",
        "timeSignature",
        "reviewed",
        "access",
        "freeUntil",
        "previewUrl",
        "parts",
        "voicings",
        "openedAt",
        "season",
        "group",
        "titles",
        "wantsVoice"
    ],
    "properties": {
        "id": {
            "type": "string",
            "description": "The template's own id (\"amazing-grace\"), as in its JSON."
        },
        "version": {
            "type": "integer",
            "description": "The current version. Guides belong to a version: a project on an older one keeps the synth for that part."
        },
        "title": {
            "type": "string"
        },
        "description": {
            "type": "string"
        },
        "difficulty": {
            "type": "string",
            "enum": [
                "beginner",
                "intermediate",
                "advanced"
            ]
        },
        "genre": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "language": {
            "type": "string",
            "description": "The language the words are sung in (BCP 47)."
        },
        "key": {
            "type": "string"
        },
        "tempo": {
            "type": "number"
        },
        "timeSignature": {
            "type": "string",
            "enum": [
                "4/4",
                "3/4",
                "6/8",
                "2/4"
            ]
        },
        "reviewed": {
            "type": "boolean",
            "description": "False for a draft the musician hasn't checked; the app shows drafts only locally or with ?drafts=1."
        },
        "openedAt": {
            "type": [
                "string",
                "null"
            ],
            "format": "date-time",
            "description": "When it opened in the library (its first reviewed version); null while hidden. Home's New and in season."
        },
        "season": {
            "type": [
                "object",
                "null"
            ],
            "additionalProperties": false,
            "required": [
                "key",
                "until"
            ],
            "description": "The season the song is in today (config templates.seasons: carols from 1 November to 26 December), for Home's tag; null otherwise.",
            "properties": {
                "key": {
                    "type": "string",
                    "enum": [
                        "carols"
                    ]
                },
                "until": {
                    "type": "string"
                }
            }
        },
        "access": {
            "type": "string",
            "enum": [
                "free",
                "account"
            ],
            "description": "free: anyone may start it, signed out too (the app bundles it); account: any signed-in account, on any plan (every library song since 2026-11-07)."
        },
        "freeUntil": {
            "type": [
                "string",
                "null"
            ],
            "format": "date-time",
            "description": "Always null: the song of the month ended on 2026-11-07. Kept for older apps."
        },
        "previewUrl": {
            "type": [
                "string",
                "null"
            ],
            "format": "uri",
            "description": "A 20 to 30 second mix on the CDN, once made in admin (from M5). Null until then."
        },
        "parts": {
            "type": "array",
            "items": {
                "$ref": "catalogue.part.json"
            }
        },
        "voicings": {
            "type": "object",
            "additionalProperties": false,
            "description": "The template's voicings: which parts sing for each number of singers, by that number. {} when it has none.",
            "properties": {
                "1": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "2": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "3": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "4": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "5": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "6": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "group": {
            "type": [
                "string",
                "null"
            ],
            "description": "The /songs group the song sits in (SongCollections::group), null for \"more\"."
        },
        "titles": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "es": {
                    "type": "string"
                },
                "de": {
                    "type": "string"
                }
            },
            "description": "The song's own titles in other languages, by language code (Frère Jacques in es); only the languages the site offers."
        },
        "wantsVoice": {
            "type": "boolean",
            "description": "An open song with a part still on the synth: Be the voice may ask for it."
        }
    },
    "title": "A song in the catalogue: what anyone may see, never the notes"
}
