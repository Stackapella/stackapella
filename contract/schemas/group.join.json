                            "type": "string"
                        }
                    }
                },
                "members": {
                    "type": "integer"
                },
                "readOnly": {
                    "type": "boolean",
                    "description": "Paused: the director's Plus has ended, so the group takes nobody new (groups.join answers 403 shared_paused)."
                }
            }
        }
    },
    "$id": "group.join.json"
