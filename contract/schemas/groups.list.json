{
    "type": "object",
    "additionalProperties": false,
    "required": [
        "data"
    ],
    "properties": {
        "data": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "id",
                    "name",
                    "role",
                    "director",
                    "members",
                    "songs",
                    "readOnly",
                    "seat"
                ],
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "role": {
                        "type": "string",
                        "enum": [
                            "director",
                            "member"
                        ]
                    },
                    "director": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "id",
                            "name"
                        ],
                        "properties": {
                            "id": {
                                "type": "string"
                            },
                            "name": {
                                "type": "string"
                            }
                        }
                    },
                    "members": {
                        "type": "integer"
                    },
                    "songs": {
                        "type": "integer"
                    },
                    "readOnly": {
                        "type": "boolean",
                        "description": "The director's Plus has ended: no new songs, members or assignments."
                    },
                    "seat": {
                        "type": "string",
                        "enum": [
                            "seated",
                            "needed"
                        ],
                        "description": "The viewer's own seat (choir seats, docs/choir-seats-plan.md): `seated` may practise and record in the group; `needed` may not (the app shows \"Ask your director to add your seat\", nothing to buy). With the choir_seats switch off, the leader's Plus decides, as readOnly does."
                    }
                }
            }
        }
    },
    "$id": "groups.list.json"
}
