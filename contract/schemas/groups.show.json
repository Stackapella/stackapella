{
    "type": "object",
    "additionalProperties": false,
    "required": [
        "data"
    ],
    "properties": {
        "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "name",
                "role",
                "director",
                "readOnly",
                "memberCount",
                "songs",
                "members",
                "link",
                "rehearsal",
                "seat",
                "seats"
            ],
            "properties": {
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "role": {
                    "type": "string",
                    "enum": [
                        "director",
                        "member"
                    ]
                },
                "director": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "id",
                        "name"
                    ],
                    "properties": {
                        "id": {
                            "type": "string"
                        },
                        "name": {
                            "type": "string"
                        }
                    }
                },
                "readOnly": {
                    "type": "boolean"
                },
                "memberCount": {
                    "type": "integer"
                },
                "songs": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "templateId",
                            "title",
                            "access",
                            "own",
                            "sharedAt",
                            "sinceRehearsal",
                            "seat"
                        ],
                        "properties": {
                            "templateId": {
                                "type": "string"
                            },
                            "title": {
                                "type": "string"
                            },
                            "access": {
                                "type": "string",
                                "enum": [
                                    "free",
                                    "account",
                                    "own"
                                ],
                                "description": "free or account as the catalogue's access; own: one of the director's templates."
                            },
                            "own": {
                                "type": "boolean"
                            },
                            "sharedAt": {
                                "type": "string",
                                "format": "date-time"
                            },
                            "sinceRehearsal": {
                                "type": [
                                    "object",
                                    "null"
                                ],
                                "additionalProperties": false,
                                "required": [
                                    "started",
                                    "recorded"
                                ],
                                "properties": {
                                    "started": {
                                        "type": "integer",
                                        "description": "Assigned members who began the song (their first project from it since the assignment) on or after the previous rehearsal's day (UTC)."
                                    },
                                    "recorded": {
                                        "type": "integer",
                                        "description": "Assignments whose ready take is from on or after that day."
                                    }
                                },
                                "description": "The director's counts since the last rehearsal, numbers only; null for a member, or before a first rehearsal."
                            },
                            "seat": {
                                "type": "string",
                                "enum": [
                                    "seated",
                                    "needed"
                                ],
                                "description": "The caller's seat for this song: as `seat` for the choir's own songs; always `seated` for a library song, one open by its link, or the caller's own, which stay free to learn alone."
                            }
                        }
                    }
                },
                "members": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "id",
                            "name",
                            "avatarUrl",
                            "role",
                            "joinedAt",
                            "assignments",
                            "seat"
                        ],
                        "properties": {
                            "id": {
                                "type": "string"
                            },
                            "name": {
                                "type": "string"
                            },
                            "role": {
                                "type": "string",
                                "enum": [
                                    "director",
                                    "member"
                                ]
                            },
                            "joinedAt": {
                                "type": "string",
                                "format": "date-time"
                            },
                            "assignments": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "required": [
                                        "templateId",
                                        "partKey",
                                        "status",
                                        "updatedAt"
                                    ],
                                    "properties": {
                                        "templateId": {
                                            "type": "string"
                                        },
                                        "partKey": {
                                            "type": "string"
                                        },
                                        "status": {
                                            "type": "string",
                                            "enum": [
                                                "none",
                                                "started",
                                                "recorded"
                                            ]
                                        },
                                        "updatedAt": {
                                            "type": [
                                                "string",
                                                "null"
                                            ],
                                            "format": "date-time",
                                            "description": "Since when it's had that status (the take's time once recorded)."
                                        }
                                    }
                                }
                            },
                            "avatarUrl": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "format": "uri"
                            },
                            "seat": {
                                "type": "string",
                                "enum": [
                                    "own",
                                    "seated",
                                    "needed"
                                ],
                                "description": "Each shown member's seat: own (their own Plus, no seat used), seated, or needed. With the switch on, a member whose seat is needed shows the director no progress (each assignment's status stays none). With it off, seated or needed as the leader's Plus decides."
                            }
                        }
                    },
                    "description": "The director sees everyone; a member sees only themselves."
                },
                "link": {
                    "type": [
                        "object",
                        "null"
                    ],
                    "additionalProperties": false,
                    "required": [
                        "url",
                        "createdAt"
                    ],
                    "properties": {
                        "url": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "description": "The join link, for the director to copy again; null for a link made before links were kept (Reset link makes one)."
                        },
                        "createdAt": {
                            "type": "string",
                            "format": "date-time"
                        }
                    },
                    "description": "The director's join link and when it was made (null before one is). A member never sees it."
                },
                "rehearsal": {
                    "type": [
                        "object",
                        "null"
                    ],
                    "additionalProperties": false,
                    "required": [
                        "date",
                        "weekly",
                        "next",
                        "previous"
                    ],
                    "properties": {
                        "date": {
                            "type": "string",
                            "description": "The date the director set: a plain local date, YYYY-MM-DD."
                        },
                        "weekly": {
                            "type": "boolean"
                        },
                        "next": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "description": "The next rehearsal on or after today (YYYY-MM-DD), worked out on read; null for a one-off that has passed. A day counts as passed once it is over everywhere (12:00 UTC the next day)."
                        },
                        "previous": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "description": "The latest rehearsal before next (YYYY-MM-DD); null before the first."
                        }
                    },
                    "description": "The group's next rehearsal as its director set it (null when none is). Members see it too."
                },
                "seat": {
                    "type": "string",
                    "enum": [
                        "seated",
                        "needed"
                    ],
                    "description": "The viewer's own seat (choir seats, docs/choir-seats-plan.md): `seated` may practise and record in the group; `needed` may not (the app shows \"Ask your director to add your seat\", nothing to buy). With the choir_seats switch off, the leader's Plus decides, as readOnly does."
                },
                "seats": {
                    "type": [
                        "object",
                        "null"
                    ],
                    "additionalProperties": false,
                    "required": [
                        "status",
                        "bought",
                        "used",
                        "min",
                        "trialEndsAt",
                        "endsAt"
                    ],
                    "properties": {
                        "status": {
                            "type": "string",
                            "enum": [
                                "none",
                                "free_trial",
                                "trialing",
                                "active",
                                "past_due",
                                "canceled",
                                "lapsed"
                            ],
                            "description": "none: never bought; free_trial: a group made before the choir_seats switch went on, in its 14 free days from that day (every member seated, nothing bought); trialing: a pack in its trial; active; past_due: Stripe retrying a payment (still seated); canceled: paid up to endsAt, not renewing; lapsed: ended (the unseated read-only, nothing deleted)."
                        },
                        "bought": {
                            "type": "integer",
                            "description": "Seats paid for now (0 unless trialing, active, past_due or canceled)."
                        },
                        "used": {
                            "type": "integer",
                            "description": "Seats held by members. Members on their own Plus, and the director, never take one."
                        },
                        "min": {
                            "type": "integer",
                            "description": "The fewest seats a pack has (10)."
                        },
                        "trialEndsAt": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "format": "date-time",
                            "description": "When the free days end (trialing or free_trial)."
                        },
                        "endsAt": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "format": "date-time",
                            "description": "When a canceled pack ends."
                        }
                    },
                    "description": "The director's seat panel while the choir_seats switch is on; null for a member, or while it's off."
                }
            }
        }
    },
    "$id": "groups.show.json"
}
