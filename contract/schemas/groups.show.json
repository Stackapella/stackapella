{
    "type": "object",
    "additionalProperties": false,
    "required": [
        "data"
    ],
    "properties": {
        "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "name",
                "role",
                "director",
                "readOnly",
                "memberCount",
                "songs",
                "members",
                "link",
                "rehearsal"
            ],
            "properties": {
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "role": {
                    "type": "string",
                    "enum": [
                        "director",
                        "member"
                    ]
                },
                "director": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "id",
                        "name"
                    ],
                    "properties": {
                        "id": {
                            "type": "string"
                        },
                        "name": {
                            "type": "string"
                        }
                    }
                },
                "readOnly": {
                    "type": "boolean"
                },
                "memberCount": {
                    "type": "integer"
                },
                "songs": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "templateId",
                            "title",
                            "access",
                            "own",
                            "sharedAt",
                            "sinceRehearsal"
                        ],
                        "properties": {
                            "templateId": {
                                "type": "string"
                            },
                            "title": {
                                "type": "string"
                            },
                            "access": {
                                "type": "string",
                                "enum": [
                                    "free",
                                    "account",
                                    "own"
                                ],
                                "description": "free or account as the catalogue's access; own: one of the director's templates."
                            },
                            "own": {
                                "type": "boolean"
                            },
                            "sharedAt": {
                                "type": "string",
                                "format": "date-time"
                            },
                            "sinceRehearsal": {
                                "type": [
                                    "object",
                                    "null"
                                ],
                                "additionalProperties": false,
                                "required": [
                                    "started",
                                    "recorded"
                                ],
                                "properties": {
                                    "started": {
                                        "type": "integer",
                                        "description": "Assigned members who began the song (their first project from it since the assignment) on or after the previous rehearsal's day (UTC)."
                                    },
                                    "recorded": {
                                        "type": "integer",
                                        "description": "Assignments whose ready take is from on or after that day."
                                    }
                                },
                                "description": "The director's counts since the last rehearsal, numbers only; null for a member, or before a first rehearsal."
                            }
                        }
                    }
                },
                "members": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "id",
                            "name",
                            "avatarUrl",
                            "role",
                            "joinedAt",
                            "assignments"
                        ],
                        "properties": {
                            "id": {
                                "type": "string"
                            },
                            "name": {
                                "type": "string"
                            },
                            "role": {
                                "type": "string",
                                "enum": [
                                    "director",
                                    "member"
                                ]
                            },
                            "joinedAt": {
                                "type": "string",
                                "format": "date-time"
                            },
                            "assignments": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "required": [
                                        "templateId",
                                        "partKey",
                                        "status",
                                        "updatedAt"
                                    ],
                                    "properties": {
                                        "templateId": {
                                            "type": "string"
                                        },
                                        "partKey": {
                                            "type": "string"
                                        },
                                        "status": {
                                            "type": "string",
                                            "enum": [
                                                "none",
                                                "started",
                                                "recorded"
                                            ]
                                        },
                                        "updatedAt": {
                                            "type": [
                                                "string",
                                                "null"
                                            ],
                                            "format": "date-time",
                                            "description": "Since when it's had that status (the take's time once recorded)."
                                        }
                                    }
                                }
                            },
                            "avatarUrl": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "format": "uri"
                            }
                        }
                    },
                    "description": "The director sees everyone; a member sees only themselves."
                },
                "link": {
                    "type": [
                        "object",
                        "null"
                    ],
                    "additionalProperties": false,
                    "required": [
                        "url",
                        "createdAt"
                    ],
                    "properties": {
                        "url": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "description": "The join link, for the director to copy again; null for a link made before links were kept (Reset link makes one)."
                        },
                        "createdAt": {
                            "type": "string",
                            "format": "date-time"
                        }
                    },
                    "description": "The director's join link and when it was made (null before one is). A member never sees it."
                },
                "rehearsal": {
                    "type": [
                        "object",
                        "null"
                    ],
                    "additionalProperties": false,
                    "required": [
                        "date",
                        "weekly",
                        "next",
                        "previous"
                    ],
                    "properties": {
                        "date": {
                            "type": "string",
                            "description": "The date the director set: a plain local date, YYYY-MM-DD."
                        },
                        "weekly": {
                            "type": "boolean"
                        },
                        "next": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "description": "The next rehearsal on or after today (YYYY-MM-DD), worked out on read; null for a one-off that has passed. A day counts as passed once it is over everywhere (12:00 UTC the next day)."
                        },
                        "previous": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "description": "The latest rehearsal before next (YYYY-MM-DD); null before the first."
                        }
                    },
                    "description": "The group's next rehearsal as its director set it (null when none is). Members see it too."
                }
            }
        }
    },
    "$id": "groups.show.json"
}
