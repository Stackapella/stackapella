{
    "$id": "ownChoir.json",
    "title": "Hear yourself as a choir: the singer's consent, quota and songs (track B phase 3)",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "data"
    ],
    "properties": {
        "data": {
            "$ref": "#/$defs/state"
        }
    },
    "$defs": {
        "state": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "consent",
                "voice",
                "termsVersion",
                "quota",
                "requests",
                "busyToday",
                "checkNeeded",
                "joined",
                "clipSongs"
            ],
            "properties": {
                "consent": {
                    "type": [
                        "object",
                        "null"
                    ],
                    "additionalProperties": false,
                    "required": [
                        "version",
                        "acceptedAt"
                    ],
                    "properties": {
                        "version": {
                            "type": "integer"
                        },
                        "acceptedAt": {
                            "type": "string",
                            "format": "date-time"
                        }
                    }
                },
                "voice": {
                    "type": [
                        "object",
                        "null"
                    ],
                    "additionalProperties": false,
                    "required": [
                        "savedAt",
                        "lastUsedAt",
                        "expiresAt",
                        "wordless",
                        "clipListen"
                    ],
                    "properties": {
                        "savedAt": {
                            "type": "string",
                            "format": "date-time"
                        },
                        "lastUsedAt": {
                            "type": "string",
                            "format": "date-time"
                        },
                        "expiresAt": {
                            "type": "string",
                            "format": "date-time",
                            "description": "Deleted then if not used again (12 months unused)."
                        },
                        "wordless": {
                            "type": "boolean",
                            "description": "Prepared from a clip of a part with no words (a hum): for a song with words the app may suggest one sung line; never required."
                        },
                        "clipListen": {
                            "type": [
                                "object",
                                "null"
                            ],
                            "additionalProperties": false,
                            "required": [
                                "url",
                                "expiresAt",
                                "templateId",
                                "sampleRate",
                                "frames",
                                "offsetFrames",
                                "clipTranspose"
                            ],
                            "description": "The singer's original clip, an AAC copy kept with their voice to compare before and after: theirs alone, a link for an hour; null until the song that made the voice is ready.",
                            "properties": {
                                "url": {
                                    "type": "string",
                                    "format": "uri"
                                },
                                "expiresAt": {
                                    "type": "string",
                                    "format": "date-time"
                                },
                                "templateId": {
                                    "type": "string"
                                },
                                "sampleRate": {
                                    "type": "integer"
                                },
                                "frames": {
                                    "type": "integer"
                                },
                                "offsetFrames": {
                                    "type": [
                                        "integer",
                                        "null"
                                    ]
                                },
                                "clipTranspose": {
                                    "type": "integer"
                                }
                            }
                        }
                    },
                    "description": "Their voice, kept privately for their next songs (prepared from their first clip); null until then, or once deleted."
                },
                "termsVersion": {
                    "type": "integer"
                },
                "quota": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "freeLeft",
                        "monthLeft",
                        "todayLeft",
                        "plus",
                        "unit",
                        "minutesLeft",
                        "minutesPerMonth",
                        "resetsAt"
                    ],
                    "properties": {
                        "freeLeft": {
                            "type": "integer"
                        },
                        "monthLeft": {
                            "type": "integer"
                        },
                        "todayLeft": {
                            "type": "integer"
                        },
                        "plus": {
                            "type": "boolean"
                        },
                        "unit": {
                            "type": "string",
                            "enum": [
                                "songs",
                                "minutes"
                            ],
                            "description": "How the allowance is counted for this person: `minutes` (part-minutes a month, paid Plus) or `songs` (the free song, or the small monthly allowance of Plus not paid for: a trial, a school code, a coach, a grant)."
                        },
                        "minutesLeft": {
                            "type": [
                                "number",
                                "null"
                            ],
                            "description": "Part-minutes left this month of the subscription's billing (unit `minutes`), else null."
                        },
                        "minutesPerMonth": {
                            "type": [
                                "number",
                                "null"
                            ],
                            "description": "The allowance in part-minutes per month of the subscription's billing (unit `minutes`), else null."
                        },
                        "resetsAt": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "format": "date-time",
                            "description": "Paid Plus: when its month of billing turns (anchored on the day it renews, never the calendar month). Plus not paid for: when the oldest song in its rolling 30 days stops counting. Null for the free song."
                        }
                    },
                    "description": "What's left: the free song (ever), this 30 days' songs (Plus not paid for, `monthLeft`) or part-minutes (paid Plus, `minutesLeft`), and today's (everyone)."
                },
                "busyToday": {
                    "type": "boolean",
                    "description": "Today's renders are full across everyone: a song asked for now is made tomorrow (`startsAfter`)."
                },
                "checkNeeded": {
                    "type": "boolean",
                    "description": "Turnstile before this person's first song: send `turnstileToken` with requests.create (only when auth.config has a `turnstileSiteKey`)."
                },
                "requests": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/request"
                    }
                },
                "joined": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "member",
                            "song"
                        ],
                        "properties": {
                            "member": {
                                "$ref": "#/$defs/member"
                            },
                            "song": {
                                "$ref": "#/$defs/request",
                                "description": "The owner's song as a member sees it: its parts (the whole choir), `voices` with `whose`, no members or invite."
                            }
                        }
                    },
                    "description": "Choirs you sing in (another singer's song you joined), newest first."
                },
                "clipSongs": {
                    "type": "array",
                    "description": "The tunes a clip may sing, in the order shown, the first the default; stopBeat where the clip stops (null: the whole tune).",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "templateId",
                            "stopBeat",
                            "songId"
                        ],
                        "properties": {
                            "templateId": {
                                "type": "string"
                            },
                            "stopBeat": {
                                "type": [
                                    "number",
                                    "null"
                                ]
                            },
                            "songId": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "request": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "templateId",
                "title",
                "version",
                "status",
                "failure",
                "createdAt",
                "readyAt",
                "seen",
                "canDownload",
                "parts",
                "progress",
                "startsAfter",
                "voices",
                "members",
                "invite",
                "left",
                "voicing",
                "settings",
                "remakeMinutes",
                "remake",
                "failureDetail",
                "counted",
                "holdUntil",
                "claimedAt",
                "queuePosition",
                "etaMinutes",
                "slow",
                "costMinutes",
                "failureHints",
                "leadTake",
                "canUseRecordingAsLead"
            ],
            "properties": {
                "id": {
                    "type": "string"
                },
                "templateId": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                },
                "version": {
                    "type": "integer"
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "uploading",
                        "queued",
                        "rendering",
                        "ready",
                        "failed"
                    ]
                },
                "failure": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Why it failed: bad_clip, clip_unusable, gates_failed, render_failed, reference_gone or expired (api.md, \"Hear yourself as a choir\")."
                },
                "createdAt": {
                    "type": "string",
                    "format": "date-time"
                },
                "readyAt": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "format": "date-time"
                },
                "startsAfter": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "format": "date-time",
                    "description": "Queued while today's renders are full: it starts no earlier than this."
                },
                "seen": {
                    "type": "boolean",
                    "description": "The singer has opened it since it was ready (the in-app notice shows until then)."
                },
                "canDownload": {
                    "type": "boolean",
                    "description": "Whether the app offers Download for this song (a WAV it mixes itself from the parts it plays): with Plus (Hillel, 2026-11-21); without it, Download opens the Plus sheet (billing.checkout moment choir_download). Listening and sharing stay free. A gate in the app, as MP3 export is, not a lock on bytes: the parts' playback links are unchanged."
                },
                "parts": {
                    "type": "array",
                    "items": {
                        "$ref": "guide.recording.json"
                    },
                    "description": "Each part in their own voice once ready (source ai, credit null, a private signed URL for 2 hours); [] until then."
                },
                "progress": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "partKey",
                            "status"
                        ],
                        "properties": {
                            "partKey": {
                                "type": "string"
                            },
                            "status": {
                                "enum": [
                                    "ready",
                                    "making",
                                    "waiting"
                                ]
                            }
                        }
                    }
                },
                "voices": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/voice"
                    },
                    "description": "Who sings each part now, once ready (with own_choir_together on; [] otherwise). `parts` holds the active render of each part."
                },
                "members": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/member"
                    },
                    "description": "The song's friends (the owner's view); [] on a song you joined, or with the switch off."
                },
                "left": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "name",
                            "at",
                            "seen"
                        ],
                        "properties": {
                            "name": {
                                "type": "string"
                            },
                            "at": {
                                "type": "string",
                                "format": "date-time"
                            },
                            "seen": {
                                "type": "boolean",
                                "description": "Marked by the owner's requests.seen."
                            }
                        }
                    },
                    "description": "Friends who left this song (or were removed, or deleted their voice or account): their parts and the shares that held them are gone; the owner's notice until seen. The owner's view only; [] otherwise."
                },
                "invite": {
                    "type": [
                        "object",
                        "null"
                    ],
                    "additionalProperties": false,
                    "required": [
                        "canInvite",
                        "parts",
                        "left",
                        "reason"
                    ],
                    "properties": {
                        "canInvite": {
                            "type": "boolean"
                        },
                        "parts": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "description": "The parts a friend would suit best (those that sit high or low for the owner), for the invite's words; [] when every part fits."
                        },
                        "left": {
                            "type": "integer",
                            "description": "Friends that can still join: the cap (1 on the free song, 7 with Plus, never more than the parts minus one) less those in it."
                        },
                        "reason": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "enum": [
                                "plus_required",
                                "full",
                                "all_fit",
                                null
                            ],
                            "description": "Why not, when canInvite is false."
                        }
                    },
                    "description": "The owner's invite line on a ready song while own_choir_together is on; null otherwise."
                },
                "voicing": {
                    "enum": [
                        "written",
                        "low",
                        "full"
                    ],
                    "description": "low: arranged for a low voice, the treble parts an octave down (\"Arranged for a low voice\")."
                },
                "settings": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "sound",
                        "sung"
                    ],
                    "description": "Choir settings (Plus to change): the mix, applied at once, and how it is sung, applied by a remake.",
                    "properties": {
                        "sound": {
                            "$ref": "#/$defs/sound"
                        },
                        "sung": {
                            "$ref": "#/$defs/sung"
                        }
                    }
                },
                "remakeMinutes": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "standard",
                        "fine",
                        "fullStandard",
                        "fullFine"
                    ],
                    "description": "The minutes a remake would use, as charged.",
                    "properties": {
                        "standard": {
                            "type": "number"
                        },
                        "fine": {
                            "type": "number"
                        },
                        "fullStandard": {
                            "type": "number"
                        },
                        "fullFine": {
                            "type": "number"
                        }
                    }
                },
                "remake": {
                    "type": [
                        "object",
                        "null"
                    ],
                    "additionalProperties": false,
                    "required": [
                        "status",
                        "progress",
                        "settings"
                    ],
                    "description": "A remake on its way (the song plays as it is meanwhile); null when none.",
                    "properties": {
                        "status": {
                            "enum": [
                                "queued",
                                "rendering",
                                "failed"
                            ]
                        },
                        "progress": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                    "partKey",
                                    "status"
                                ],
                                "properties": {
                                    "partKey": {
                                        "type": "string"
                                    },
                                    "status": {
                                        "enum": [
                                            "ready",
                                            "making",
                                            "waiting"
                                        ]
                                    }
                                }
                            }
                        },
                        "settings": {
                            "$ref": "#/$defs/sung"
                        }
                    }
                },
                "failureDetail": {
                    "enum": [
                        "length",
                        "quiet",
                        "loud",
                        "noisy",
                        "edge",
                        "short",
                        "notes",
                        null
                    ],
                    "description": "Why its clip couldn't be used (with failure clip_unusable), for its singer alone; null otherwise."
                },
                "holdUntil": {
                    "type": ["string", "null"],
                    "format": "date-time",
                    "description": "A song the app started by itself waits this long before the renderer may take it (10 s, held up to 2 minutes while they listen back; null once taken or started)."
                },
                "claimedAt": {
                    "type": ["string", "null"],
                    "format": "date-time",
                    "description": "When the renderer first took it; from then a stop still counts toward the singer's songs or minutes."
                },
                "queuePosition": {
                    "type": ["integer", "null"],
                    "description": "Its place in line while it waits for the renderer (1 is next); null once taken, while held, or on a busy day's wait."
                },
                "etaMinutes": {
                    "type": ["integer", "null"],
                    "description": "Roughly how many minutes until it's made, while it waits or is being made; null when about to start or not on its way."
                },
                "slow": {
                    "type": "boolean",
                    "description": "Past twice its estimate: the app says it's taking longer than usual, and that they'll be emailed."
                },
                "costMinutes": {
                    "type": "number",
                    "description": "The part-minutes it uses of paid Plus's month (the free choir's own line comes from quota)."
                },
                "failureHints": {
                    "type": [
                        "array",
                        "null"
                    ],
                    "items": {
                        "enum": [
                            "near",
                            "quietSinger",
                            "noReference"
                        ]
                    },
                    "description": "With failure clip_unusable, for its singer alone: what the measures say about fixing it ([] when nothing applies). near: it came close to passing; quietSinger: noise was the reason, but they sang quietly; noReference: the notes didn't fit because they sang in another key, or drifted from one, with no starting note to hold to. Null otherwise."
                },
                "counted": {
                    "type": [
                        "boolean",
                        "null"
                    ],
                    "description": "A failed song: whether it counted toward its singer's free song, Plus songs or Plus minutes (false: given back). Null for a song not failed. The daily cap counts every song the renderer worked on either way."
                },
                "leadTake": {
                    "type": [
                        "object",
                        "null"
                    ],
                    "additionalProperties": false,
                    "required": [
                        "id",
                        "partKey",
                        "url",
                        "sampleRate",
                        "frames",
                        "offsetFrames"
                    ],
                    "description": "Their own recording of the tune as the lead (the whole song sung, or Happy Birthday's capture), levelled to the parts, in the song's key as rendered: theirs alone, a link for 2 hours; null when there's none.",
                    "properties": {
                        "id": {
                            "type": "string"
                        },
                        "partKey": {
                            "type": "string"
                        },
                        "url": {
                            "type": "string",
                            "format": "uri"
                        },
                        "sampleRate": {
                            "type": "integer"
                        },
                        "frames": {
                            "type": "integer"
                        },
                        "offsetFrames": {
                            "type": "integer"
                        }
                    }
                },
                "canUseRecordingAsLead": {
                    "type": "boolean",
                    "description": "Their recording covers this whole song, so it can be the lead (You + choir, the lead blend); else the app offers Record the lead."
                }
            }
        },
        "voice": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "partKey",
                "whose",
                "name",
                "memberId",
                "status",
                "fit"
            ],
            "properties": {
                "partKey": {
                    "type": "string"
                },
                "whose": {
                    "type": "string",
                    "enum": [
                        "you",
                        "friend",
                        "owner"
                    ],
                    "description": "Whose AI voice sings this part now: `you` (yours), `friend` (a friend's, on your song), `owner` (the song's owner's, on a song you joined)."
                },
                "name": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "That person's first name (null for `you`); inside the choir only."
                },
                "memberId": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "The member whose voice it is (null for the owner's)."
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "ready",
                        "on_its_way",
                        "waiting_minutes"
                    ],
                    "description": "`ready`; `on_its_way` (the friend's render is being made: the owner's plays meanwhile); `waiting_minutes` (the owner hasn't the part-minutes left for it yet: the owner's plays)."
                },
                "fit": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "enum": [
                        "high",
                        "low",
                        null
                    ],
                    "description": "For the owner only: the part sits mostly above (`high`) or below (`low`) their range (under half its sung time inside it); null when it fits, or on a song you joined."
                }
            }
        },
        "member": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "requestId",
                "name",
                "parts",
                "status",
                "showName",
                "joinedAt",
                "seen",
                "minutesShort"
            ],
            "properties": {
                "id": {
                    "type": "string"
                },
                "requestId": {
                    "type": "string",
                    "description": "The owner's song."
                },
                "name": {
                    "type": "string",
                    "description": "First name, as members see each other."
                },
                "parts": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "The parts their voice sings in this song (ChoirAssign)."
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "uploading",
                        "on_its_way",
                        "waiting_minutes",
                        "ready",
                        "failed"
                    ],
                    "description": "Their part of the song: the clip on its way (`uploading`), being made, waiting for the owner's minutes, made, or failed (the owner's parts play)."
                },
                "showName": {
                    "type": "boolean",
                    "description": "Their first name on shared pages (off by default)."
                },
                "joinedAt": {
                    "type": "string",
                    "format": "date-time"
                },
                "seen": {
                    "type": "boolean",
                    "description": "The friend has seen their parts ready (ownChoir.requests.seen on the song they joined); Home's quiet card while false."
                },
                "minutesShort": {
                    "type": [
                        "number",
                        "null"
                    ],
                    "description": "While `waiting_minutes`: the part-minutes the owner lacks for these parts (made once the owner's `quota.resetsAt` passes); else null."
                }
            }
        },
        "sound": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "room",
                "balance",
                "leadBlend",
                "recordingLevel"
            ],
            "properties": {
                "room": {
                    "enum": [
                        "dry",
                        "small",
                        "hall",
                        "chapel"
                    ]
                },
                "balance": {
                    "type": "array",
                    "description": "Each part's level in dB (−12 to 6), in the song's order.",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "partKey",
                            "db"
                        ],
                        "properties": {
                            "partKey": {
                                "type": "string"
                            },
                            "db": {
                                "type": "number"
                            }
                        }
                    }
                },
                "leadBlend": {
                    "type": [
                        "number",
                        "null"
                    ],
                    "description": "0 to 1 within You + choir: 0 their real take as the lead, 1 the AI tune; null as the view says."
                },
                "recordingLevel": {
                    "type": [
                        "number",
                        "null"
                    ],
                    "description": "Their original clip mixed under the choir, in dB (−24 to 0); null off."
                }
            }
        },
        "sung": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "vibrato",
                "variation",
                "humanize",
                "voicing",
                "breaths",
                "quality",
                "ensembleTiming",
                "pitchSpread"
            ],
            "properties": {
                "vibrato": {
                    "enum": [
                        "none",
                        "light",
                        "natural",
                        "strong"
                    ],
                    "description": "Vibrato (natural unless chosen)."
                },
                "variation": {
                    "enum": [
                        "steady",
                        "natural",
                        "loose"
                    ],
                    "description": "Natural variation: the wander, glides into notes, how each part's singer differs (natural unless chosen)."
                },
                "humanize": {
                    "type": "integer",
                    "description": "Older apps only (one release): derived from vibrato, 0 to 3."
                },
                "voicing": {
                    "enum": [
                        "auto",
                        "low",
                        "full",
                        "high",
                        "written"
                    ]
                },
                "breaths": {
                    "enum": [
                        "legato",
                        "natural"
                    ]
                },
                "quality": {
                    "enum": [
                        "standard",
                        "fine"
                    ]
                },
                "ensembleTiming": {
                    "enum": [
                        "tight",
                        "natural",
                        "loose"
                    ]
                },
                "pitchSpread": {
                    "enum": [
                        "off",
                        "subtle",
                        "wide"
                    ]
                }
            }
        }
    }
}
