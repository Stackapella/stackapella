{
    "$id": "ownChoir.requests.download.json",
    "title": "A made choir song's parts at full quality, for Download (Plus)",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "data"
    ],
    "properties": {
        "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "parts",
                "leadTake"
            ],
            "properties": {
                "parts": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "partKey",
                            "url",
                            "sampleRate",
                            "frames",
                            "offsetFrames"
                        ],
                        "properties": {
                            "partKey": {
                                "type": "string"
                            },
                            "url": {
                                "type": "string",
                                "format": "uri",
                                "description": "Full quality, private, for 5 minutes: fetch at once."
                            },
                            "sampleRate": {
                                "type": "integer"
                            },
                            "frames": {
                                "type": "integer"
                            },
                            "offsetFrames": {
                                "type": "integer"
                            }
                        }
                    }
                },
                "leadTake": {
                    "type": [
                        "object",
                        "null"
                    ],
                    "additionalProperties": false,
                    "required": [
                        "id",
                        "partKey",
                        "url",
                        "sampleRate",
                        "frames",
                        "offsetFrames"
                    ],
                    "description": "Their own recording of the tune as the lead (the whole song sung, or Happy Birthday's capture), levelled to the parts, in the song's key as rendered: theirs alone, a link for 2 hours; null when there's none.",
                    "properties": {
                        "id": {
                            "type": "string"
                        },
                        "partKey": {
                            "type": "string"
                        },
                        "url": {
                            "type": "string",
                            "format": "uri"
                        },
                        "sampleRate": {
                            "type": "integer"
                        },
                        "frames": {
                            "type": "integer"
                        },
                        "offsetFrames": {
                            "type": "integer"
                        }
                    }
                }
            }
        }
    }
}
