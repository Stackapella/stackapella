{
    "$id": "rights.here.json",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "data"
    ],
    "properties": {
        "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "country",
                "withheld"
            ],
            "properties": {
                "country": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "The visitor's country (ISO 3166), or null when unknown (every country's rule then applies)."
                },
                "withheld": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "The songs (slugs) withheld there. Empty while geo_rights is off."
                }
            }
        }
    }
}
