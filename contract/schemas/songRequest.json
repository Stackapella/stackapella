{
    "$id": "songRequest.json",
    "title": "A song request (N7)",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "id",
        "title",
        "writer",
        "why",
        "votes",
        "voted",
        "mine",
        "status",
        "template",
        "createdAt"
    ],
    "properties": {
        "id": {
            "type": "string"
        },
        "title": {
            "type": "string"
        },
        "writer": {
            "type": [
                "string",
                "null"
            ]
        },
        "why": {
            "type": [
                "string",
                "null"
            ]
        },
        "votes": {
            "type": "integer"
        },
        "voted": {
            "type": "boolean"
        },
        "mine": {
            "type": "boolean",
            "description": "The caller asked for it."
        },
        "status": {
            "type": "string",
            "enum": [
                "requested",
                "checking",
                "arranging",
                "ready",
                "cant"
            ]
        },
        "template": {
            "type": [
                "object",
                "null"
            ],
            "additionalProperties": false,
            "required": [
                "id",
                "title"
            ],
            "properties": {
                "id": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                }
            }
        },
        "createdAt": {
            "type": [
                "string",
                "null"
            ],
            "format": "date-time"
        }
    }
}
