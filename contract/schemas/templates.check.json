{
    "$id": "templates.check.json",
    "title": "A draft song's checks: what would refuse it, and the advice",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "data"
    ],
    "properties": {
        "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "problems",
                "advice"
            ],
            "properties": {
                "problems": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "advice": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "kind",
                            "text"
                        ],
                        "properties": {
                            "kind": {
                                "type": "string"
                            },
                            "text": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    }
}
