{
    "$id": "worker.choir.claim.json",
    "title": "A track B render job, claimed (the worker API)",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "data"
    ],
    "properties": {
        "data": {
            "$ref": "#/$defs/job"
        }
    },
    "$defs": {
        "job": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "claim",
                "template",
                "version",
                "title",
                "data",
                "clip",
                "reference",
                "parts",
                "own",
                "voicing",
                "shifts",
                "settings"
            ],
            "properties": {
                "id": {
                    "type": "string"
                },
                "claim": {
                    "type": "string",
                    "description": "This claim's token: send it as `claim` with parts.create, references.create and jobs.finish; only the claim holding it acts on the job."
                },
                "template": {
                    "type": "string"
                },
                "version": {
                    "type": "integer"
                },
                "title": {
                    "type": "string"
                },
                "own": {
                    "type": "boolean",
                    "description": "The singer's own song from the creator, not a library one: a gates failure isn't rendered again (finish `gates_failed`, counted as the singer's)."
                },
                "data": {
                    "type": "object",
                    "description": "The version's template.json."
                },
                "clip": {
                    "type": [
                        "object",
                        "null"
                    ],
                    "additionalProperties": false,
                    "required": [
                        "url",
                        "sampleRate",
                        "frames",
                        "sha256",
                        "part",
                        "offsetFrames",
                        "template",
                        "version",
                        "data",
                        "transpose",
                        "guide"
                    ],
                    "properties": {
                        "url": {
                            "type": "string",
                            "format": "uri",
                            "description": "A presigned GET, 30 minutes."
                        },
                        "sampleRate": {
                            "type": "integer"
                        },
                        "frames": {
                            "type": "integer"
                        },
                        "sha256": {
                            "type": "string"
                        },
                        "part": {
                            "type": "string",
                            "description": "The part the singer sang along to."
                        },
                        "offsetFrames": {
                            "type": [
                                "integer",
                                "null"
                            ],
                            "description": "The clip frame where the song's beat 0 falls (latency removed), or null if the app didn't know."
                        },
                        "template": {
                            "type": "string",
                            "description": "The template the clip sings (voice-capture by default), not the song being made."
                        },
                        "version": {
                            "type": "integer"
                        },
                        "data": {
                            "type": "object",
                            "description": "The clip template's template.json as sung (notes before its stopBeat): prepare the reference against it."
                        },
                        "transpose": {
                            "type": "integer",
                            "description": "Semitones (−12 to 12) the tune was moved to the singer's first note; `data`'s notes already carry it."
                        },
                        "guide": {
                            "type": "boolean",
                            "description": "false: sung with no headphones, nothing playing, the tempo kept by eye; align phrase by phrase."
                        }
                    },
                    "description": "A new clip to prepare (exactly one of clip and reference)."
                },
                "reference": {
                    "type": [
                        "object",
                        "null"
                    ],
                    "additionalProperties": false,
                    "required": [
                        "id",
                        "url",
                        "sampleRate",
                        "frames",
                        "sha256",
                        "meta"
                    ],
                    "properties": {
                        "id": {
                            "type": "string"
                        },
                        "url": {
                            "type": "string",
                            "format": "uri",
                            "description": "A presigned GET, 30 minutes."
                        },
                        "sampleRate": {
                            "type": "integer"
                        },
                        "frames": {
                            "type": "integer"
                        },
                        "sha256": {
                            "type": "string"
                        },
                        "meta": {
                            "type": "object",
                            "description": "The renderer's own metadata, as it sent it."
                        }
                    },
                    "description": "The singer's saved voice, prepared before (exactly one of clip and reference)."
                },
                "parts": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "The parts to render, by key."
                },
                "voicing": {
                    "enum": [
                        "written",
                        "low",
                        "full"
                    ],
                    "description": "low: `data` is the low-voice version (treble parts an octave down), rendered as given."
                },
                "shifts": {
                    "type": "array",
                    "description": "Each part's octave shift in `data` (−12 or 0), for logs and checks; `data` already carries it.",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "partKey",
                            "shift"
                        ],
                        "properties": {
                            "partKey": {
                                "type": "string"
                            },
                            "shift": {
                                "type": "integer"
                            }
                        }
                    }
                },
                "settings": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "humanize",
                        "breaths",
                        "quality",
                        "ensembleTiming",
                        "pitchSpread"
                    ],
                    "description": "How it's sung (Plus's choir settings; the defaults are today's sound). Voicing is already in `data`.",
                    "properties": {
                        "humanize": {
                            "type": "integer",
                            "description": "0 to 3: 0 the clean line, each step more vibrato and variation."
                        },
                        "breaths": {
                            "enum": [
                                "legato",
                                "natural"
                            ]
                        },
                        "quality": {
                            "enum": [
                                "standard",
                                "fine"
                            ]
                        },
                        "ensembleTiming": {
                            "enum": [
                                "tight",
                                "natural",
                                "loose"
                            ]
                        },
                        "pitchSpread": {
                            "enum": [
                                "off",
                                "subtle",
                                "wide"
                            ]
                        }
                    }
                }
            }
        }
    }
}
