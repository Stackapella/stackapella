# Stackapella's server. Copy to .env for local work (cp .env.example .env && php artisan key:generate).
# Production sets these in the App Platform console, never in .do/app.yaml (secrets are marked SECRET).

APP_NAME=Stackapella
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# The address people use. Locally, php artisan serve --port=8000.
APP_URL=http://127.0.0.1:8000
# The public site's address (docs/app-subdomain-plan.md): unset, both are APP_URL's host.
PUBLIC_URL=
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
# The deployed commit; App Platform sets it.
APP_BUILD=
# The PWA's folder. Defaults to ../web next to server/.
WEB_PATH=
# The beta domain before launch: "coming soon" for anyone without an invite link (true there).
COMING_SOON=false
# The oldest app version the API still serves (X-App-Version); empty serves every version.
MIN_APP_VERSION=
# Public IDs: a shuffled alphabet, fixed for good once IDs are public (changing it breaks links).
SQIDS_ALPHABET=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# MySQL 8.4 only, tests included (no SQLite anywhere).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=stackapella
DB_USERNAME=root
DB_PASSWORD=
# The tests' database: each run gets its own, named from this plus TEST_DB_TOKEN or
# CLAUDE_CODE_SESSION_ID. It must contain "test".
DB_TEST_DATABASE=stackapella_test
# Production only: DigitalOcean Managed MySQL's CA certificate (PEM), for TLS to the database.
DB_CA_CERT=

SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
# true in production (HTTPS only).
SESSION_SECURE_COOKIE=false

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# Storage aliases: local disks here, Spaces in production (spaces_media, spaces_private, spaces_backup).
MEDIA_DISK=media_local
PRIVATE_DISK=private_local
BACKUP_DISK=backup_local
MEDIA_URL=http://127.0.0.1:8000/media
# The real-instrument samples (php artisan app:instruments:upload): on once some are uploaded.
INSTRUMENTS_ENABLED=false
SPACES_KEY=
# SECRET
SPACES_SECRET=
SPACES_REGION=nyc3
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_BUCKET=stackapella-media
SPACES_PRIVATE_BUCKET=stackapella-private
SPACES_BACKUP_BUCKET=stackapella-backup
# The backup bucket's own key (scoped to it alone), so the app's key can't delete backups.
BACKUP_SPACES_KEY=
# SECRET
BACKUP_SPACES_SECRET=
# The media bucket's CDN address, for public files.
CDN_URL=
# The landing's film (site.showreel): unset, it's CDN_URL/showreel when MEDIA_DISK is spaces_media
# (where app:showreel:upload puts it), else /videos/showreel locally. Set it only to override.
SHOWREEL_URL=
# To purge a removed file from the CDN at once: a DigitalOcean API token (write) and the CDN
# endpoint's id. Without them a removed guide lingers at the edge until its cache expires.
# SECRET
DIGITALOCEAN_TOKEN=
DIGITALOCEAN_CDN_ENDPOINT_ID=

# Mail: the log mailer locally; Cloudflare Email Service in production (from M3).
MAIL_MAILER=log
# Cloudflare Email Service (MAIL_MAILER=cloudflare): the account and an API token that can send.
CLOUDFLARE_ACCOUNT_ID=
# SECRET
CLOUDFLARE_EMAIL_TOKEN=
MAIL_FROM_ADDRESS="contact@stackapella.com"
MAIL_FROM_NAME="${APP_NAME}"
# The one email to mudeo's users goes from stackapella.com through Cloudflare Email Sending
# (docs/mudeo-transition-plan.md). Sending refuses until the footer's postal address is set;
# MAIL_MUDEO_READY=false holds it back (unset: ready).
MAIL_MUDEO_FROM="hillel@stackapella.com"
MAIL_MUDEO_REPLY_TO="contact@stackapella.com"
MAIL_MUDEO_READY=
MAIL_POSTAL_ADDRESS="Stackapella, 14799 Soaring Eagle Ct, Fort Myers, FL 33912, USA"

# Behind Cloudflare and App Platform (production): read the client's real IP from
# do-connecting-ip and CF-Connecting-IP (config/proxies.php). false locally.
BEHIND_APP_PLATFORM=false

# The admin: three checks (config/admin.php). Comma-separated, lower case.
ADMIN_GOOGLE_IDS=
ADMIN_EMAILS=
EDITOR_GOOGLE_IDS=
EDITOR_EMAILS=
# Only honoured locally: false skips the second factor on this laptop.
ADMIN_2FA_REQUIRED=true
ADMIN_IDLE_TIMEOUT=240
ADMIN_MAX_LIFETIME=720
ADMIN_SUDO_WINDOW=30

# Sign in with Google (Socialite). The callback is APP_URL/auth/google/callback.
GOOGLE_CLIENT_ID=
# SECRET
GOOGLE_CLIENT_SECRET=

# Sign in with Apple: the Services ID, the team, and a Sign in with Apple key (its .p8, on one line
# with \n for the line breaks). Needs the Apple developer account.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# SECRET
APPLE_PRIVATE_KEY=

# The native apps' own sign-ins (their ID tokens are checked against these): Google's OAuth client
# IDs for the apps (one per platform, comma-separated) and the apps' bundle id for Apple.
GOOGLE_APP_CLIENT_IDS=
APPLE_APP_BUNDLE_ID=

# Cloudflare Turnstile, shown only in shield mode (an attack switch).
TURNSTILE_SITE_KEY=
# SECRET
TURNSTILE_SECRET=

# Plus billing: Stripe (test keys only outside production), its webhook secret (the endpoint is
# /webhooks/stripe), and the monthly and yearly prices (each with EUR and GBP currency options).
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTH=
STRIPE_PRICE_YEAR=
# Stripe's "I agree to the terms" box on Checkout: true once the terms' address is set in Stripe.
STRIPE_TERMS_CHECKBOX=false

# Plus bought in the apps (docs/app-purchases-plan.md). The App Store Connect API key (Users and
# Access, Integrations: issuer, key id, the .p8 on one line with \n) and the product ids.
APP_STORE_ISSUER_ID=
APP_STORE_KEY_ID=
# SECRET
APP_STORE_PRIVATE_KEY=
APP_STORE_PRODUCT_MONTH=com.stackapella.plus.month
APP_STORE_PRODUCT_YEAR=com.stackapella.plus.year
# Google Play: the package, the service account's JSON key (Play Console, API access), the
# subscription, and the Pub/Sub push's audience (this app's /webhooks/google-play) and account.
GOOGLE_PLAY_PACKAGE=
# SECRET
GOOGLE_PLAY_SERVICE_ACCOUNT=
GOOGLE_PLAY_SUBSCRIPTION=plus
GOOGLE_PLAY_PUSH_AUDIENCE=
GOOGLE_PLAY_PUSH_EMAIL=
# Push to the native apps, off until true: APNs (a token-based .p8 key; the team and topic fall
# back to APPLE_TEAM_ID and APPLE_APP_BUNDLE_ID) and Firebase Cloud Messaging.
APP_PUSH_ENABLED=false
APNS_KEY_ID=
APNS_TEAM_ID=
# SECRET
APNS_PRIVATE_KEY=
APNS_TOPIC=
FCM_PROJECT_ID=
# SECRET
FCM_SERVICE_ACCOUNT=
# Coaching (M8): Stripe Connect's own webhook (/webhooks/stripe-connect, account.updated).
STRIPE_CONNECT_WEBHOOK_SECRET=

# Event Schedule (M9): Stackapella's OAuth client there (its admin registers it, with the redirect
# <APP_URL>/connect/event-schedule/callback). Locally, EVENT_SCHEDULE_FAKE=true uses the fake
# instead, whose sign-in comes straight back (a selfhosted key for it starts with "es-").
EVENT_SCHEDULE_URL=https://eventschedule.com
EVENT_SCHEDULE_CLIENT_ID=
# SECRET
EVENT_SCHEDULE_CLIENT_SECRET=
EVENT_SCHEDULE_FAKE=false

# Invoice Ninja (M10): each coach's token, and Stackapella's own, is kept with its connection.
# Locally, INVOICE_NINJA_FAKE=true uses the fake (a token starting "in-" is accepted).
INVOICE_NINJA_FAKE=false

# Running it (L, docs/runbook.md). Sentry is off without a DSN (the browser's goes through our
# /log/errors tunnel). MAIL_WEBHOOK_SECRET is shared with the Worker that forwards Cloudflare's
# bounces and complaints. APP_REDIRECT_HOSTS lists the launch domain's other names (never the
# beta's). MYSQL_CLIENT_PATH is where mysqldump is, if not on the PATH; RESTORE_DRILL_DATABASE a
# scratch database for the drill on a managed server. SITE_INDEXING=true (at launch, on the launch
# domain only) lets search engines index the songs, guides and legal pages.
SENTRY_LARAVEL_DSN=
SENTRY_BROWSER_DSN=
# The scheduled jobs with a Sentry cron monitor (comma-separated names from routes/console.php).
SENTRY_CRON_MONITORS=backup-database
# SECRET
MAIL_WEBHOOK_SECRET=
APP_REDIRECT_HOSTS=
SECURITY_CONTACT=contact@stackapella.com
MYSQL_CLIENT_PATH=
RESTORE_DRILL_DATABASE=
SITE_INDEXING=false

# Practice reminders (web push): make the keys once with `php artisan app:reminders:keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Our own posts on X (OAuth 1.0a, read-write, as @stackapella) and Bluesky (the domain handle and
# an app password). Empty locally: nothing posts.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
# Our featured posts carry the harmony's share video, not its card: on after a test post on each network.
SOCIAL_VIDEOS=false
# Posts go out only in production, after Hillel approves each one in /admin.
BLUESKY_SERVICE=https://bsky.social

# Passkeys: a secret for the opaque user handles; defaults to APP_KEY.
PASSKEYS_USER_HANDLE_SECRET=
# The admins' passkeys belong to this domain: unset, APP_URL's registrable domain (stackapella.com
# from app.stackapella.com), so they work on every host of it.
PASSKEYS_RP_ID=

# Running it yourself (config/selfhost.php; the README's "Running it yourself"). Off on
# stackapella.com. SELF_HOSTED=true gives every account Plus and shows your own legal texts (in
# SELF_HOSTED_LEGAL_PATH, default resources/legal/local: en/terms.md, en/privacy.md...).
SELF_HOSTED=false
# Whether this install is stackapella.com itself, which serves our marketing site (the landing,
# features, pricing, about, press, the song and guide pages, the sitemap; docs/branding-matrix.md).
# Leave it false on your own install: you may run the app under the AAL, not our site. Unset, it's
# true only for stackapella.com's addresses, local development and the tests.
# IS_NEXUS=false
SELF_HOSTED_LEGAL_PATH=
# Whether requests come through Cloudflare (the weekly check of its IP ranges runs only then). Unset:
# on unless SELF_HOSTED.
BEHIND_CLOUDFLARE=
# Your own addresses on the public pages (unset: Stackapella's). SITE_BLUESKY_URL=none hides the link.
SITE_CONTACT_EMAIL=
# Legal questions and copyright notices (unset: legal@stackapella.com).
SITE_LEGAL_EMAIL=
SITE_FOUNDER=
SITE_FOUNDER_URL=
SITE_X_URL=
SITE_BLUESKY_URL=
